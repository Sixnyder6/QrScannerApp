uniform float2 iResolution;
uniform float iTime;
uniform float flowSpeed;
uniform float complexity;
uniform float3 layerColorA;   // тёмное бордо (основа)
uniform float3 layerColorB;   // насыщенный красный (середина)
uniform float3 layerColorC;   // тёплый персик (свет)
uniform float brightness;

half hash(float2 p) {
    p = fract(p * 0.3183099 + float2(0.1, 0.2));
    p *= 17.0;
    return fract(p.x * p.y * (p.x + p.y));
}

half noise(float2 x) {
    float2 i = floor(x); float2 f = fract(x);
    float a = hash(i); float b = hash(i + float2(1.0, 0.0));
    float c = hash(i + float2(0.0, 1.0)); float d = hash(i + float2(1.0, 1.0));
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

half fbm(float2 p) {
    half v = 0.0; half a = 0.5; float2 shift = float2(100.0, 50.0);
    mat2 rot = mat2(cos(0.35), sin(0.35), -sin(0.35), cos(0.35));
    v += a * noise(p); p = rot * p * 2.0 + shift; a *= 0.45;
    v += a * noise(p); p = rot * p * 2.0 - shift; a *= 0.45;
    v += a * noise(p); p = rot * p * 2.0 + shift; a *= 0.4;
    v += a * noise(p);
    return v;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord.xy / iResolution.xy;
    float2 p = (fragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;
    float t = iTime * flowSpeed;

    // Органический дрейф с лёгким подъёмом (как жар от огня)
    float2 q = float2(
        fbm(p + float2(0.06 * t, -0.09 * t)),
        fbm(p + float2(0.07 * t, 0.0) + float2(2.1, 0.8))
    );

    float2 r = float2(
        fbm(p + complexity * q + float2(1.3, 4.5) + float2(0.11 * t, -0.05 * t)),
        fbm(p + complexity * q + float2(7.1, 1.9) + float2(0.04 * t, 0.08 * t))
    );

    float f = fbm(p + complexity * 1.1 * r + float2(0.025 * t, -0.04 * t));

    // Подъём яркости снизу вверх (uv.y=0 низ, uv.y=1 верх в OpenGL)
    float rise = uv.y;

    // Плавный трёхслойный переход: бордо → красный → персик
    float depth = clamp(f * f * 1.7 + rise * 0.35, 0.0, 1.0);
    float3 col = mix(layerColorA, layerColorB, smoothstep(0.0, 0.45, depth));
    col = mix(col, layerColorC, smoothstep(0.38, 0.78, depth));

    // Мерцание на пиках — тёплые персиковые искры
    float spark = smoothstep(0.72, 0.90, depth) * (0.5 + 0.5 * sin(iTime * 3.1 + p.x * 8.0));
    col += layerColorC * spark * 0.14;

    // Мягкий виньет
    float vig = 1.0 - length(uv - 0.5) * 0.38;
    col *= vig;

    col *= brightness;
    return half4(col, 1.0);
}