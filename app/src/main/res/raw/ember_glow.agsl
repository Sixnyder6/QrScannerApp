uniform float2 iResolution;
uniform float iTime;
uniform float flowSpeed;
uniform float complexity;
uniform float3 layerColorA;   // тёмное бордо
uniform float3 layerColorB;   // насыщенный красный
uniform float3 layerColorC;   // тёплый персик
uniform float brightness;

half hash(float2 p) {
    p = fract(p * 0.3183099 + float2(0.1, 0.2));
    p *= 17.0;
    return fract(p.x * p.y * (p.x + p.y));
}

// 2 октавы вместо 4 — встроил noise прямо в fbm для скорости
half fbm(float2 p) {
    float2 shift = float2(100.0, 50.0);
    mat2 rot = mat2(cos(0.35), sin(0.35), -sin(0.35), cos(0.35));

    // Октава 1
    float2 i = floor(p); float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    half n1 = mix(mix(hash(i), hash(i + float2(1.0, 0.0)), u.x),
                  mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x), u.y);

    // Октава 2
    p = rot * p * 2.2 + shift;
    i = floor(p); f = fract(p);
    u = f * f * (3.0 - 2.0 * f);
    half n2 = mix(mix(hash(i), hash(i + float2(1.0, 0.0)), u.x),
                  mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x), u.y);

    return 0.55 * n1 + 0.3 * n2;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord.xy / iResolution.xy;
    float2 p = (fragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;
    float t = iTime * flowSpeed;

    // Один уровень domain warp (было два)
    float2 q = float2(
        fbm(p + float2(0.06 * t, -0.09 * t)),
        fbm(p + float2(0.07 * t, 0.0) + float2(2.1, 0.8))
    );

    // Основной шум от warped координат
    float f = fbm(p + complexity * 1.1 * q + float2(0.025 * t, -0.04 * t));

    // Подъём яркости снизу вверх
    float rise = uv.y;

    // Трёхслойный цвет — clamp вместо smoothstep
    float depth = clamp(f * f * 1.7 + rise * 0.35, 0.0, 1.0);
    float3 col = mix(layerColorA, layerColorB, clamp(depth / 0.45, 0.0, 1.0));
    col = mix(col, layerColorC, clamp((depth - 0.38) / 0.40, 0.0, 1.0));

    // Искры — clamp вместо smoothstep
    float spark = clamp((depth - 0.72) / 0.18, 0.0, 1.0) * (0.5 + 0.5 * sin(t * 3.1 + p.x * 8.0));
    col += layerColorC * spark * 0.12;

    // Виньет
    float vig = 1.0 - length(uv - 0.5) * 0.35;
    col *= vig * brightness;

    return half4(col, 1.0);
}