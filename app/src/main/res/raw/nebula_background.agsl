uniform float2 iResolution;
uniform float iTime;
uniform float flowSpeed;
uniform float complexity;
uniform float3 nebulaColorA;   // глубокий тёмный синий (дно)
uniform float3 nebulaColorB;   // светлый голубой (поверхность)
uniform float density;

half hash(float2 p) {
    p = fract(p * 0.3183099 + 0.1);
    p *= 17.0;
    return fract(p.x * p.y * (p.x + p.y));
}

// 2 октавы, noise встроен
half fbm(float2 p) {
    float2 shift = float2(100.0);
    mat2 rot = mat2(cos(0.3), sin(0.3), -sin(0.3), cos(0.3));

    float2 i = floor(p); float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    half a = hash(i); half b = hash(i + float2(1.0, 0.0));
    half c = hash(i + float2(0.0, 1.0)); half d = hash(i + float2(1.0, 1.0));
    half n1 = mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;

    p = rot * p * 2.0 + shift;
    i = floor(p); f = fract(p);
    u = f * f * (3.0 - 2.0 * f);
    a = hash(i); b = hash(i + float2(1.0, 0.0));
    c = hash(i + float2(0.0, 1.0)); d = hash(i + float2(1.0, 1.0));
    half n2 = mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;

    return 0.55 * n1 + 0.3 * n2;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord.xy / iResolution.xy;
    float2 p = (fragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;
    float t = iTime * flowSpeed;

    // Один уровень warp (было два)
    float2 q = float2(
        fbm(p + float2(0.10 * t, 0.0)),
        fbm(p + float2(0.0, 0.06 * t) + float2(3.2, 1.5))
    );

    // Основной шум — fbm от warped координат
    float f = fbm(p + complexity * 0.8 * q);

    // Глубина: низ=темно, верх=светло
    float depth = 1.0 - uv.y;

    // Переход — clamp вместо smoothstep
    float blend = clamp(f * 1.3 + depth * 0.5, 0.0, 1.0);
    float3 color = mix(nebulaColorA, nebulaColorB, clamp(blend, 0.0, 1.0));

    // Блики — clamp вместо smoothstep
    float shimmer = clamp((f - 0.62) / 0.20, 0.0, 1.0) * (depth + 0.2) * 0.16;
    color += nebulaColorB * shimmer;

    // Виньет
    float vig = 1.0 - length(uv - 0.5) * 0.38;
    color *= vig;

    return half4(color * density, 1.0);
}