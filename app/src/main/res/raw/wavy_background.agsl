uniform float2 iResolution;
uniform float iTime;
uniform half4 backgroundColor;
uniform half4 midEnergyColor;
uniform half4 coreEnergyColor;
uniform float animationSpeed;
uniform float energyBrightness;
uniform float mainOrbitRadius;
uniform float piston1SpeedMult;
uniform float piston2SpeedMult;
uniform float rampMidPoint;
uniform float rampCorePoint;

half4 main(float2 fragCoord) {
    float2 uv = (fragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;
    float time = iTime * animationSpeed;

    // Коленвал
    float2 crank = float2(cos(time), sin(time)) * mainOrbitRadius;

    // Поршень 1
    float2 p1 = float2(sin(time * piston1SpeedMult), cos(time)) * (mainOrbitRadius * 2.0);

    // Поршень 2
    float p2x = crank.x + sin(time * piston2SpeedMult) * (mainOrbitRadius * 1.5);
    float p2y = crank.y + cos(time * (piston2SpeedMult + 1.0)) * (mainOrbitRadius * 1.5);

    // Энергия — clamp вместо smoothstep
    float e1 = 1.0 - clamp(length(uv - crank) / 0.8, 0.0, 1.0);
    float e2 = 1.0 - clamp(length(uv - p1) / 0.6, 0.0, 1.0);
    float e3 = 1.0 - clamp(length(uv - float2(p2x, p2y)) / 0.7, 0.0, 1.0);

    float totalEnergy = (e1 + e2 + e3) * energyBrightness;
    totalEnergy += sin(uv.x * 5.0 + time) * 0.1;

    // Цвет — clamp вместо smoothstep
    half4 finalColor = mix(backgroundColor, midEnergyColor, clamp(totalEnergy / rampMidPoint, 0.0, 1.0));
    finalColor = mix(finalColor, coreEnergyColor, clamp((totalEnergy - rampMidPoint) / (rampCorePoint - rampMidPoint), 0.0, 1.0));

    return finalColor;
}