uniform float2 iResolution;
uniform float iTime;
uniform float breathRate;
uniform float cellDensity;
uniform float3 tissueColor;
uniform float3 glowColor;
uniform float pulseStrength;

// Лёгкий хеш — sin вместо dot
half2 hash2(float2 p) {
    return fract(sin(float2(dot(p, float2(127.1, 311.7)), dot(p, float2(269.5, 183.3)))) * 43758.5453);
}

// Voronoi — 3x3 фиксированный цикл
half voronoi(float2 x, float time, float breathingPhase) {
    float2 n = floor(x);
    float2 f = fract(x);
    float m = 8.0;

    for(int j = -1; j <= 1; j++) {
        for(int i = -1; i <= 1; i++) {
            float2 g = float2(float(i), float(j));
            float2 o = hash2(n + g);
            // Анимация ядра — один sin
            float2 offset = 0.5 + 0.5 * sin(time + 6.2831 * o);
            float2 r = g + offset - f;
            float d = length(r);
            d *= 1.0 - 0.2 * breathingPhase;
            if(d < m) m = d;
        }
    }
    return half(m);
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord.xy / iResolution.xy;
    float2 p = (fragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;

    float breath = sin(iTime * breathRate) * 0.5 + 0.5;
    p *= 1.0 - 0.05 * breath;

    // Только один слой Voronoi (было два)
    half v1 = voronoi(p * cellDensity, iTime * 0.25, breath);

    // Органический паттерн — clamp вместо smoothstep
    half organicPattern = clamp(v1 * v1 * 1.2, 0.0, 1.0);

    // Свечение ядер — x³ через умножение вместо pow
    half light = 1.0 - organicPattern;
    light = light * light * light;
    light *= 1.0 + pulseStrength * breath;

    // Цвет — mix с clamp
    float3 col = mix(tissueColor, glowColor, clamp(light, 0.0, 1.0));
    col += glowColor * 0.15 * clamp(light * (1.0 - light) * 2.0, 0.0, 1.0);

    // Виньет
    float vig = 1.0 - length(uv - 0.5) * 0.75;
    col *= vig;

    return half4(col, 1.0);
}