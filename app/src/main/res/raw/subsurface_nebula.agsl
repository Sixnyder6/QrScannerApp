uniform float2 iResolution;
uniform float iTime;
uniform float flowSpeed;
uniform float complexity;
uniform float3 nebulaColorA;
uniform float3 nebulaColorB;
uniform float density;

half hash(float2 p) {
    p = fract(p * 0.3183099 + 0.1);
    p *= 17.0;
    return fract(p.x * p.y * (p.x + p.y));
}

// 2 октавы, noise встроен
half fbm(float2 p) {
    float2 shift = float2(100.0);
    mat2 rot = mat2(cos(0.5), sin(0.5), -sin(0.5), cos(0.5));

    float2 i = floor(p); float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    half a = hash(i); half b = hash(i + float2(1.0, 0.0));
    half c = hash(i + float2(0.0, 1.0)); half d = hash(i + float2(1.0, 1.0));
    half n1 = mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;

    p = rot * p * 2.0 + shift;
    i = floor(p); f = fract(p);
    u = f * f * (3.0 - 2.0 * f);
    a = hash(i); b = hash(i + float2(1.0, 0.0));
    c = hash(i + float2(0.0, 1.0)); d = hash(i + float2(1.0, 1.0));
    half n2 = mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;

    return 0.55 * n1 + 0.3 * n2;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord.xy / iResolution.xy;
    float2 p = (fragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;
    float t = iTime * flowSpeed;

    // Один уровень warp (было два: q + r)
    float2 q = float2(
        fbm(p + float2(0.15 * t, 0.0)),
        fbm(p + float2(0.0, 0.126 * t) + float2(1.7, 9.2))
    );

    // Основной шум
    float f = fbm(p + complexity * q);

    // Цвет: f² для резких краёв «дыма», clamp вместо mix с константой
    float sharp = clamp(f * f * 4.0, 0.0, 1.0);
    float3 color = mix(nebulaColorA, nebulaColorB, sharp);

    // Deep space затемнение — clamp вместо mix с length(q)
    float darken = clamp(length(q) * 0.7, 0.0, 1.0);
    color = mix(color, float3(0.0, 0.0, 0.08), darken);

    // Хроматическая аберрация убрана (экономия 2 fbm)
    // Тоновая кривая убрана (второй порядок почти не виден)

    // Виньет
    float vig = 1.0 - length(uv - 0.5) * 0.48;
    color *= vig;

    return half4(color * density, 1.0);
}