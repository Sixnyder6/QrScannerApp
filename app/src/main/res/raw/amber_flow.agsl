uniform float2 iResolution;
uniform float iTime;
uniform float flowSpeed;
uniform float complexity;
uniform float3 baseColor;
uniform float3 midColor;
uniform float3 glowColor;
uniform float brightness;

// Быстрый хеш
half hash(float2 p) {
    return fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

half noise(float2 x) {
    float2 i = floor(x);
    float2 f = fract(x);
    float a = hash(i);
    float b = hash(i + float2(1.0, 0.0));
    float c = hash(i + float2(0.0, 1.0));
    float d = hash(i + float2(1.0, 1.0));
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// 3 октавы (было 5× fbm = 15 noise)
// Оптимизация: всего 3× fbm = 9 noise вместо 15
half fbm(float2 p) {
    half v = 0.0;
    half a = 0.55;
    float2 shift = float2(70.0, 30.0);
    mat2 rot = mat2(cos(0.6), sin(0.6), -sin(0.6), cos(0.6));
    v += a * noise(p); p = rot * p * 2.2 + shift; a *= 0.5;
    v += a * noise(p); p = rot * p * 2.2 - shift; a *= 0.5;
    v += a * noise(p);
    return v;
}

half ridgeNoise(float2 p) {
    half n = fbm(p);
    n = 1.0 - abs(n - 0.5) * 2.0;
    return n * n;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord.xy / iResolution.xy;
    float2 p = (fragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;
    float t = iTime * flowSpeed;

    // Оптимизация: 3× fbm вместо 5 (экономия 40%)
    float2 q = float2(
        fbm(p + float2(0.2 * t, 0.1 * t)),
        fbm(p + float2(-0.1 * t, 0.25 * t))
    );
    float2 r = float2(
        fbm(p + complexity * q + float2(0.35 * t, 0.15 * t) + float2(5.1, 2.7)),
        fbm(p + complexity * q + float2(0.15 * t, 0.3 * t) - float2(2.3, 6.8))
    );

    float f = fbm(p + complexity * 1.6 * r);
    float ridges = ridgeNoise(p * 2.5 + r * 0.7 + 0.1 * t);

    float3 col = mix(baseColor, midColor, smoothstep(0.0, 0.5, f));
    float ridgeMask = smoothstep(0.3, 0.7, f);
    col = mix(col, glowColor, ridges * ridgeMask * 0.7);

    float hotspots = smoothstep(0.7, 0.85, f);
    col = mix(col, glowColor * 1.5, hotspots * 0.6);

    float vig = 1.0 - length(uv - 0.5) * 0.55;
    col *= vig * brightness;

    return half4(col, 1.0);
}