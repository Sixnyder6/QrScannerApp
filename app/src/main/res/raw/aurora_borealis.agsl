uniform float2 iResolution;
uniform float iTime;
uniform float flowSpeed;
uniform float complexity;
uniform float3 layerColorA;   // зелёный (нижний край лучей)
uniform float3 layerColorB;   // голубой/бирюзовый (середина)
uniform float3 layerColorC;   // фиолетовый (верхний край)
uniform float brightness;

// Быстрый хеш — одна строка без dot/dot
half hash21(float2 p) {
    return fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float t = iTime * flowSpeed;
    float ux = uv.x;
    float uy = uv.y;

    // === ЗВЁЗДНОЕ НЕБО (упрощённое) ===
    // Меньшая плотность сетки: 60×40 (было 100×80) — экономия 62%
    float2 sGrid = uv * float2(60.0, 40.0);
    float2 sCell = floor(sGrid);
    float2 sOff  = fract(sGrid) - 0.5;
    float  sRand = hash21(sCell);
    float  star  = smoothstep(0.98, 1.0, sRand)
                 * smoothstep(0.025, 0.0, length(sOff));

    // === АВРОРА — одна общая полоса вместо двух ===
    // Оптимизировано: 3 sin вместо 6, вынесено за скобки
    float wave = ux * complexity;
    float topY = 0.30
        + 0.055 * sin(wave * 3.1  + t * 0.30)
        + 0.032 * sin(wave * 7.2  - t * 0.48 + 1.6)
        + 0.025 * sin(wave * 13.5 + t * 0.22 + 3.1);

    float dy  = uy - topY;
    float ray = exp(-max(dy, 0.0) * 5.8) * step(0.0, dy);
    float halo = exp(-max(-dy, 0.0) * 18.0) * step(0.0, -dy) * 0.35;

    // Куртины — 2 sin вместо 4
    float cx = 0.0;
    cx += 0.55 * sin(ux * 5.2 + t * 0.26);
    cx += 0.35 * sin(ux * 9.7 - t * 0.43 + 2.3);
    cx = cx * 0.5 + 0.5;

    // Детализация — один шумовой проход (было с noise)
    float detail = 0.55 + 0.45 * sin(ux * 8.0 + uy * 4.0 + t * 0.3);

    float aurora = (ray + halo) * cx * detail;

    // === ЦВЕТ ===
    float colorT = 1.0 - clamp(dy / 0.30, 0.0, 1.0);
    float3 auroraCol = mix(layerColorA, layerColorB, smoothstep(0.10, 0.50, colorT));
    auroraCol = mix(auroraCol, layerColorC, smoothstep(0.42, 0.88, colorT));

    float pulse = 0.82 + 0.18 * sin(t * 1.6 + ux * 3.5);
    auroraCol *= pulse;

    // === НОЧНОЕ НЕБО ===
    float3 sky = float3(0.004, 0.005, 0.018);

    // === ИТОГ ===
    float starVis = 1.0 - smoothstep(0.2, 0.7, aurora);
    float3 result = sky
        + float3(star) * float3(0.82, 0.90, 1.00) * starVis * 0.7
        + auroraCol * aurora;

    return half4(clamp(result * brightness, 0.0, 1.0), 1.0);
}