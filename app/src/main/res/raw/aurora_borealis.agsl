uniform float2 iResolution;
uniform float iTime;
uniform float flowSpeed;
uniform float complexity;
uniform float3 layerColorA;   // зелёный (нижний край лучей)
uniform float3 layerColorB;   // голубой/бирюзовый (середина)
uniform float3 layerColorC;   // фиолетовый (верхний край)
uniform float brightness;

half hash21(float2 p) {
    float2 q = fract(p * float2(443.897, 441.423));
    q += dot(q, q + 19.19);
    return fract(q.x * q.y);
}

half noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(hash21(i), hash21(i + float2(1.0, 0.0)), u.x),
        mix(hash21(i + float2(0.0, 1.0)), hash21(i + float2(1.0, 1.0)), u.x),
        u.y
    );
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    // Android Compose: uv.y=0 верх экрана, uv.y=1 низ
    float t = iTime * flowSpeed;

    // === ЗВЁЗДНОЕ НЕБО ===
    float2 sGrid = uv * float2(100.0, 80.0);
    float2 sCell = floor(sGrid);
    float2 sOff  = fract(sGrid) - 0.5;
    float  sRand = hash21(sCell);
    float  sBr   = smoothstep(0.965, 1.0, sRand);
    float  sSz   = 0.018 + 0.014 * hash21(sCell + 5.1);
    float  sTw   = 0.55 + 0.45 * sin(t * (1.8 + sRand * 5.5) + sRand * 6.28);
    float  star  = sBr * smoothstep(sSz, 0.0, length(sOff)) * sTw;

    // === АВРОРА — ПОЛОСА 1 (главная) ===
    // topY: волнистая верхняя граница. В Android-координатах малое Y = верх экрана.
    float topY1 = 0.30
        + 0.055 * sin(uv.x * 3.1 * complexity + t * 0.30)
        + 0.032 * sin(uv.x * 7.2 * complexity - t * 0.48 + 1.6)
        + 0.016 * sin(uv.x * 13.5 * complexity + t * 0.22 + 3.1);

    // dy > 0: ниже верхней границы (вниз по экрану)
    float dy1  = uv.y - topY1;
    float ray1 = exp(-max(dy1, 0.0) * 5.8) * step(0.0, dy1);

    // Тонкий ореол выше границы
    float halo1 = exp(-max(-dy1, 0.0) * 18.0) * step(0.0, -dy1) * 0.35;

    // Детализация внутри луча — мерцающие полосы
    float detail1 = 0.55 + 0.45 * noise(float2(uv.x * 9.0 + t * 0.35, uv.y * 5.0 - t * 0.15));

    // Занавесочная структура по X
    float cx1 = 0.0;
    cx1 += 0.50 * sin(uv.x * 5.2  + t * 0.26);
    cx1 += 0.30 * sin(uv.x * 9.7  - t * 0.43 + 2.3);
    cx1 += 0.20 * sin(uv.x * 2.9  + t * 0.15 + 1.1);
    cx1 = cx1 * 0.5 + 0.5;

    float aurora1 = (ray1 + halo1) * cx1 * detail1;

    // === АВРОРА — ПОЛОСА 2 (вторичная, ниже) ===
    float topY2 = 0.48
        + 0.038 * sin(uv.x * 4.3 * complexity - t * 0.20 + 2.0)
        + 0.020 * sin(uv.x * 8.8 * complexity + t * 0.35 + 0.8);

    float dy2  = uv.y - topY2;
    float ray2 = exp(-max(dy2, 0.0) * 9.5) * step(0.0, dy2) * 0.48;

    float cx2 = 0.0;
    cx2 += 0.55 * sin(uv.x * 6.8  - t * 0.29 + 1.2);
    cx2 += 0.45 * sin(uv.x * 11.5 + t * 0.37);
    cx2 = cx2 * 0.5 + 0.5;

    float aurora2 = ray2 * cx2;

    float totalAurora = aurora1 + aurora2;

    // === ЦВЕТ ЛУЧЕЙ ===
    // colorT: 0 = далеко от topY1 (зелёный низ), 1 = у topY1 (фиолетовый верх)
    float colorT = 1.0 - clamp(dy1 / 0.30, 0.0, 1.0);
    float3 auroraCol = mix(layerColorA, layerColorB, smoothstep(0.10, 0.50, colorT));
    auroraCol = mix(auroraCol, layerColorC, smoothstep(0.42, 0.88, colorT));

    // Пульс — дышащая яркость
    float pulse = 0.82 + 0.18 * sin(t * 1.6 + uv.x * 3.5);
    auroraCol *= pulse;

    // === НОЧНОЕ НЕБО ===
    float3 sky = float3(0.004, 0.005, 0.018);
    sky += float3(0.0, 0.003, 0.010) * (1.0 - uv.y); // чуть светлее к верху

    // Мягкое рассеянное свечение от авроры
    float3 ambient = auroraCol * 0.06 * smoothstep(0.0, 0.6, totalAurora + 0.08);

    // === ИТОГ ===
    // Звёзды прячутся там где аврора яркая
    float starVis = 1.0 - smoothstep(0.2, 0.7, totalAurora);
    float3 result = sky
        + float3(star) * float3(0.82, 0.90, 1.00) * starVis
        + auroraCol * totalAurora
        + ambient;

    return half4(clamp(result * brightness, 0.0, 1.0), 1.0);
}