uniform float2 iResolution;
uniform float iTime;
uniform float flowSpeed;
uniform float complexity;
uniform float3 layerColorA;   // зелёный
uniform float3 layerColorB;   // голубой/бирюзовый
uniform float3 layerColorC;   // фиолетовый
uniform float brightness;

// Лёгкий хеш для звёзд
half hash21(float2 p) {
    half h = dot(p, float2(127.1, 311.7));
    return fract(sin(h) * 43758.5453);
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float t = iTime * flowSpeed;

    // === ЗВЁЗДЫ (упрощённые) ===
    float2 sGrid = uv * float2(100.0, 80.0);
    float2 sCell = floor(sGrid);
    float2 sOff  = fract(sGrid) - 0.5;
    float  sRand = hash21(sCell);
    // Убрал второй hash, sSz фиксированный
    float  sBr   = step(0.97, sRand);
    float  sTw   = 0.55 + 0.45 * sin(t * 2.5 + sRand * 6.28);
    float  star  = sBr * smoothstep(0.025, 0.0, length(sOff)) * sTw;

    // === АВРОРА — ПОЛОСА 1 ===
    float topY1 = 0.30
        + 0.055 * sin(uv.x * 3.1 * complexity + t * 0.30)
        + 0.032 * sin(uv.x * 7.2 * complexity - t * 0.48 + 1.6);
    // Убрал третий синус (мелкая рябь почти не видна)

    float dy1  = uv.y - topY1;
    float ray1 = exp(-max(dy1, 0.0) * 5.8) * step(0.0, dy1);
    float halo1 = exp(-max(-dy1, 0.0) * 18.0) * 0.35;

    // Детализация через sin вместо noise — гораздо дешевле
    float detail1 = 0.55 + 0.45 * sin(uv.x * 9.0 + t * 0.35 + uv.y * 5.0 - t * 0.15);

    // Занавесочная структура — 2 синуса вместо 3
    float cx1 = 0.5 * sin(uv.x * 5.2 + t * 0.26)
              + 0.3 * sin(uv.x * 9.7 - t * 0.43 + 2.3);
    cx1 = cx1 * 0.5 + 0.5;

    float aurora1 = (ray1 + halo1) * cx1 * detail1;

    // === АВРОРА — ПОЛОСА 2 ===
    float topY2 = 0.48
        + 0.038 * sin(uv.x * 4.3 * complexity - t * 0.20 + 2.0)
        + 0.020 * sin(uv.x * 8.8 * complexity + t * 0.35);

    float dy2  = uv.y - topY2;
    float ray2 = exp(-max(dy2, 0.0) * 9.5) * step(0.0, dy2) * 0.48;

    float cx2 = 0.55 * sin(uv.x * 6.8 - t * 0.29 + 1.2)
              + 0.45 * sin(uv.x * 11.5 + t * 0.37);
    cx2 = cx2 * 0.5 + 0.5;

    float aurora2 = ray2 * cx2;
    float totalAurora = aurora1 + aurora2;

    // === ЦВЕТ — clamp вместо smoothstep ===
    float colorT = 1.0 - clamp(dy1 / 0.30, 0.0, 1.0);
    float3 auroraCol = mix(layerColorA, layerColorB, clamp((colorT - 0.10) / 0.40, 0.0, 1.0));
    auroraCol = mix(auroraCol, layerColorC, clamp((colorT - 0.42) / 0.46, 0.0, 1.0));

    float pulse = 0.82 + 0.18 * sin(t * 1.6 + uv.x * 3.5);
    auroraCol *= pulse;

    // === НОЧНОЕ НЕБО ===
    float3 sky = float3(0.004, 0.005, 0.018) + float3(0.0, 0.003, 0.010) * (1.0 - uv.y);

    // Рассеянное свечение — clamp вместо smoothstep
    float3 ambient = auroraCol * 0.06 * clamp(totalAurora + 0.08, 0.0, 0.68);

    // === ИТОГ ===
    float starVis = 1.0 - clamp((totalAurora - 0.2) / 0.5, 0.0, 1.0);
    float3 result = sky
        + star * float3(0.82, 0.90, 1.00) * starVis
        + auroraCol * totalAurora
        + ambient;

    return half4(clamp(result * brightness, 0.0, 1.0), 1.0);
}