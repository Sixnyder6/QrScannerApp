uniform float2 iResolution;
uniform float iTime;
uniform float flowSpeed;
uniform float complexity;
uniform float3 layerColorA;    // Глубокий фоновый слой
uniform float3 layerColorB;    // Средний слой тумана
uniform float3 layerColorC;    // Светлый жемчужный верх
uniform float brightness;

half hash(float2 p) {
    p = fract(p * 0.3183099 + float2(0.1, 0.2));
    p *= 17.0;
    return fract(p.x * p.y * (p.x + p.y));
}

// 2 октавы, noise встроен
half fbm(float2 p) {
    float2 shift = float2(100.0, 50.0);
    mat2 rot = mat2(cos(0.3), sin(0.3), -sin(0.3), cos(0.3));

    float2 i = floor(p); float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    half n1 = mix(mix(hash(i), hash(i + float2(1.0, 0.0)), u.x),
                  mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x), u.y);

    p = rot * p * 2.0 + shift;
    i = floor(p); f = fract(p);
    u = f * f * (3.0 - 2.0 * f);
    half n2 = mix(mix(hash(i), hash(i + float2(1.0, 0.0)), u.x),
                  mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x), u.y);

    return 0.55 * n1 + 0.3 * n2;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord.xy / iResolution.xy;
    float2 p = (fragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;
    float t = iTime * flowSpeed;

    // Один уровень domain warp (было два)
    float2 q = float2(
        fbm(p + float2(0.0, 0.2 * t)),
        fbm(p + float2(0.3 * t, 0.0))
    );

    // Основной шум
    float f = fbm(p + complexity * 1.5 * q + float2(0.05 * t, -0.03 * t));

    // Глубина тумана
    float depth = clamp(f * f * 1.8, 0.0, 1.0);

    // Три слоя — clamp вместо smoothstep
    float3 col = mix(layerColorA, layerColorB, clamp(depth / 0.4, 0.0, 1.0));
    col = mix(col, layerColorC, clamp((depth - 0.3) / 0.4, 0.0, 1.0));

    // Жемчужное свечение
    col += layerColorC * 0.12 * clamp((depth - 0.55) / 0.25, 0.0, 1.0);

    // Виньет
    float vig = 1.0 - length(uv - 0.5) * 0.32;
    col *= vig * brightness;

    return half4(col, 1.0);
}