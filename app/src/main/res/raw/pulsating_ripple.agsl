uniform float2 iResolution;
uniform float iTime;
uniform float3 u_color;

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float2 p = uv - float2(0.5, 0.5);

    // Коррекция аспекта
    float aspect = iResolution.x / iResolution.y;
    float dist = length(float2(p.x * max(aspect, 1.0), p.y / min(aspect, 1.0)));

    // period = 1.4
    float t = fract(iTime / 1.4);
    float tri = 1.0 - abs(2.0 * t - 1.0);
    float eased = tri * tri * (3.0 - 2.0 * tri);
    float scale = 0.88 + 0.24 * eased;

    float alpha = 0.20 * (1.0 - t);

    // SDF круга
    float radius = 0.48;
    float aa = 1.5 / min(iResolution.x, iResolution.y);
    float circle = 1.0 - smoothstep(radius / scale - aa, radius / scale + aa, dist);

    float a = circle * alpha;
    return half4(half3(u_color) * a, a);
}