uniform float2 iResolution;
uniform float iTime;
uniform float u_phaseOffset;
uniform float u_period;
uniform float u_angle;
uniform float u_intensity;

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;

    // Направление луча
    float2 dir = float2(cos(u_angle), sin(u_angle));

    // Проекция на ось движения
    float proj = dot(uv - float2(0.5), dir);

    // Центр луча
    float cx = -0.85 + 1.70 * fract(iTime / u_period + u_phaseOffset);

    // Мягкие края — clamp вместо smoothstep, beam² оставляем
    float dist  = abs(proj - cx);
    float halfW = 0.12;
    float beam  = clamp(1.0 - dist / halfW, 0.0, 1.0);
    beam = beam * beam;

    float a = beam * u_intensity;
    return half4(a, a, a, a);
}