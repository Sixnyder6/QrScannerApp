uniform float2 iResolution;
uniform float  iTime;
uniform float  u_phaseOffset;  // 0..1 — стартовый сдвиг цикла для виджета
uniform float  u_period;       // длина цикла в секундах (8.0 = sheen, 2.2 = скелетон)
uniform float  u_angle;        // угол луча в радианах (0.61 ≈ 35°, 0.0 = горизонталь)
uniform float  u_intensity;    // яркость пика (0..1)

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;

    // Направление движения луча
    float2 dir = float2(cos(u_angle), sin(u_angle));

    // Проекция uv на ось движения: диапазон ~-0.7..0.7
    float proj = dot(uv - float2(0.5), dir);

    // Центр луча движется от -0.85 до +0.85 за один цикл
    float t  = fract(iTime / u_period + u_phaseOffset);
    float cx = mix(-0.85, 0.85, t);

    // Мягкие края: smoothstep + квадрат для яркого ядра
    float dist  = abs(proj - cx);
    float halfW = 0.12;
    float beam  = 1.0 - smoothstep(0.0, halfW, dist);
    beam = beam * beam;

    // Premultiplied white overlay
    float a = beam * u_intensity;
    return half4(a, a, a, a);
}