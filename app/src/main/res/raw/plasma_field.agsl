uniform float2 iResolution;
uniform float iTime;
uniform float flowSpeed;
uniform float complexity;
uniform float3 layerColorA;   // индиго
uniform float3 layerColorB;   // маджента
uniform float3 layerColorC;   // электрик/циан
uniform float brightness;

// Палитра — clamp вместо smoothstep, зацикленная
half3 palette(float t) {
    t = fract(t);
    half3 col = mix(layerColorA, layerColorB, clamp(t / 0.48, 0.0, 1.0));
    col = mix(col, layerColorC, clamp((t - 0.38) / 0.42, 0.0, 1.0));
    col = mix(col, layerColorA, clamp((t - 0.75) / 0.25, 0.0, 1.0));
    return col;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float aspect = iResolution.x / iResolution.y;
    float t = iTime * flowSpeed;

    float2 p = (uv - 0.5) * float2(aspect, 1.0) * complexity * 3.2;

    // Один слой domain warp (было три слоя с отдельными warp)
    float wx = sin(p.y * 1.35 + t * 0.38) * 0.48 + sin(p.x * 1.92 - t * 0.27 + 1.1) * 0.24;
    float wy = cos(p.x * 1.28 - t * 0.33 + 2.3) * 0.48 + cos(p.y * 1.85 + t * 0.21) * 0.24;
    float2 wp = p + float2(wx, wy);

    // Все волны в одном слое — 5 синусов вместо 11
    float v = 0.0;
    v += sin(wp.x + t * 1.00);
    v += sin(wp.y * 0.88 + t * 1.12);
    v += sin((wp.x * 0.76 + wp.y * 0.64) + t * 0.83);
    v += sin(length(wp) * 1.14 - t * 0.76);
    v += 0.55 * sin(wp.x * 2.08 - wp.y * 1.25 + t * 1.28);

    // Добавляем мелкую деталь (бывший v3) без отдельного warp
    float2 p3 = p * 3.1 - float2(t * 0.08, t * 0.11);
    v += 0.13 * sin(p3.x * 0.6 + t * 0.9);
    v += 0.13 * sin(p3.y * 0.7 - t * 0.8);
    v += 0.07 * sin(length(p3) * 0.5 + t * 0.5);

    float plasma = v / 5.5;

    // Цвет
    float colorPhase = plasma * 0.8 + iTime * flowSpeed * 0.04;
    half3 col = palette(colorPhase);

    // Тоновая кривая — clamp вместо smoothstep
    float lum = col.r * 0.299 + col.g * 0.587 + col.b * 0.114;
    col = mix(col, col * col * 2.2, clamp((lum - 0.2) / 0.6, 0.0, 1.0) * 0.45);

    // Искры — clamp вместо smoothstep
    float spark = clamp((plasma - 0.3) / 0.2, 0.0, 1.0);
    col += layerColorC * spark * 0.1;

    // Виньет
    float vig = 1.0 - length(uv - 0.5) * 0.5;
    col *= vig * brightness;

    return half4(clamp(col, 0.0, 1.0), 1.0);
}