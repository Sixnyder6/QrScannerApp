uniform float2 iResolution;
uniform float iTime;
uniform float u_alpha;
uniform float3 u_color;

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float2 p = uv - float2(0.5, 0.5);

    // Коррекция аспекта одним умножением
    float dist = length(float2(p.x * (iResolution.x / iResolution.y), p.y));

    // Константы заранее посчитаны: r=0.28, r²=0.0784
    // core: exp(-dist² / 0.0094)  →  exp(-dist² * 106.38)
    // bloom: exp(-dist² / 0.043) →  exp(-dist² * 23.26)
    float d2 = dist * dist;
    float core  = exp(-d2 * 106.38);
    float bloom = exp(-d2 * 23.26);

    float breath = 1.0 + 0.07 * sin(iTime * 1.5);
    float intensity = (core * 0.65 + bloom * 0.35) * breath * u_alpha;

    return half4(half3(u_color) * intensity, intensity);
}