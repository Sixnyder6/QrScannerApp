uniform float2 iResolution;
uniform float iTime;
uniform float flowSpeed;
uniform float complexity;
uniform float3 deepFoldColor;
uniform float3 silkBaseColor;
uniform float3 highlightColor;
uniform float brightness;

half hash(float2 p) {
    p = fract(p * 0.3183099 + float2(0.71, 0.13));
    p *= 19.0;
    return fract(p.x * p.y * (p.x + p.y));
}

half noise(float2 x) {
    float2 i = floor(x);
    float2 f = fract(x);
    float a = hash(i);
    float b = hash(i + float2(1.0, 0.0));
    float c = hash(i + float2(0.0, 1.0));
    float d = hash(i + float2(1.0, 1.0));
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// 3 октавы вместо 5 — экономия 40% на каждом вызове
half fbm(float2 p) {
    half v = 0.0;
    half a = 0.5;
    float2 shift = float2(100.0, 60.0);
    mat2 rot = mat2(cos(0.4), sin(0.4), -sin(0.4), cos(0.4));
    v += a * noise(p); p = rot * p * 2.0 + shift; a *= 0.5;
    v += a * noise(p); p = rot * p * 2.0 - shift; a *= 0.5;
    v += a * noise(p);
    return v;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord.xy / iResolution.xy;
    float2 p = (fragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;
    float t = iTime * flowSpeed;

    // 4 fbm вместо 9 (убран gradient normal map — 4 вызова)
    float horizontalFolds = fbm(float2(p.x * 3.5 + 0.2 * t, p.y * 1.8 + 0.05 * t));
    float verticalDrape   = fbm(float2(p.x * 1.2 + 0.1 * t, p.y * 2.5 - 0.35 * t));

    // Один warp float вместо float2 из двух отдельных fbm
    float warp = fbm(p * 1.5 + float2(0.08 * t, -0.12 * t) + horizontalFolds * 0.3);
    float microDetail = fbm(p * 2.8 + warp * complexity);

    float foldDepth = horizontalFolds * 0.4 + verticalDrape * 0.45 + microDetail * 0.15;

    // Блики по высоте складки — без gradient/normal map
    half hilight = pow(smoothstep(0.3, 0.9, foldDepth), 3.0) * 0.75;

    float3 col = mix(deepFoldColor, silkBaseColor, smoothstep(0.0, 0.55, foldDepth));
    col = mix(col, highlightColor, hilight);
    col += silkBaseColor * 0.08 * (1.0 - foldDepth);

    float vig = 1.0 - length(uv - 0.5) * 0.4;
    col *= vig * brightness;

    return half4(col, 1.0);
}