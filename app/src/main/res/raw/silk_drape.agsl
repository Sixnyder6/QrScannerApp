uniform float2 iResolution;
uniform float iTime;
uniform float flowSpeed;
uniform float complexity;
uniform float3 deepFoldColor;
uniform float3 silkBaseColor;
uniform float3 highlightColor;
uniform float brightness;

half hash(float2 p) {
    p = fract(p * 0.3183099 + float2(0.71, 0.13));
    p *= 19.0;
    return fract(p.x * p.y * (p.x + p.y));
}

// 2 октавы, noise встроен
half fbm(float2 p) {
    float2 shift = float2(100.0, 60.0);
    mat2 rot = mat2(cos(0.4), sin(0.4), -sin(0.4), cos(0.4));

    float2 i = floor(p); float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    half n1 = mix(mix(hash(i), hash(i + float2(1.0, 0.0)), u.x),
                  mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x), u.y);

    p = rot * p * 2.0 + shift;
    i = floor(p); f = fract(p);
    u = f * f * (3.0 - 2.0 * f);
    half n2 = mix(mix(hash(i), hash(i + float2(1.0, 0.0)), u.x),
                  mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x), u.y);

    return 0.55 * n1 + 0.3 * n2;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord.xy / iResolution.xy;
    float2 p = (fragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;
    float t = iTime * flowSpeed;

    // 3 fbm вместо 4
    float horizontalFolds = fbm(float2(p.x * 3.5 + 0.2 * t, p.y * 1.8 + 0.05 * t));
    float verticalDrape   = fbm(float2(p.x * 1.2 + 0.1 * t, p.y * 2.5 - 0.35 * t));

    float foldDepth = horizontalFolds * 0.45 + verticalDrape * 0.45;

    // Блики — clamp вместо smoothstep, x³ через умножение
    float hilight = clamp((foldDepth - 0.25) / 0.65, 0.0, 1.0);
    hilight = hilight * hilight * hilight * 0.7;

    // Цвет — clamp вместо smoothstep
    float3 col = mix(deepFoldColor, silkBaseColor, clamp(foldDepth / 0.55, 0.0, 1.0));
    col = mix(col, highlightColor, hilight);
    col += silkBaseColor * 0.07 * (1.0 - clamp(foldDepth, 0.0, 1.0));

    // Виньет
    float vig = 1.0 - length(uv - 0.5) * 0.38;
    col *= vig * brightness;

    return half4(col, 1.0);
}